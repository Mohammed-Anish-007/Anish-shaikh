<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><corners android:radius="4dp" /><solid android:color="#1E2B4A" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape><corners android:radius="4dp" /><gradient android:angle="0" android:startColor="#22D3EE" android:endColor="#34D399" /></shape>
        </clip>
    </item>
</layer-list>
